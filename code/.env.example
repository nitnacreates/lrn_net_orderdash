# Copy to .env and fill in. Never commit .env.

# --- Postgres (runs in docker-compose, no external credentials needed) ---
POSTGRES_DB=orderdash
POSTGRES_USER=orderdash
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Central.Api ---
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=postgres;Port=5432;Database=orderdash;Username=orderdash;Password=change-me

# --- Auth ---
JWT__Key=replace-with-a-long-random-string
JWT__Issuer=orderdash.iaspirant.com
JWT__Audience=orderdash.iaspirant.com
BRIDGE__ApiKey=replace-with-a-random-api-key

# --- Seed admin user ---
SEED__AdminEmail=admin@iaspirant.com
SEED__AdminPassword=change-me

# --- Dashboard (Next) ---
NEXT_PUBLIC_API_BASE=/api

# --- Hosting ---
DOMAIN=orderdash.iaspirant.com
